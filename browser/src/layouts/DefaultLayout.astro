---
import BaseLayout from './BaseLayout.astro'
import { asset } from '../lib/asset'
import IsqLogo from '../components/IsqLogo.vue'
import SiteFooter from '../components/SiteFooter.vue'
import BackToTop from '../components/BackToTop.vue'
import AppToast from '../components/AppToast.vue'
import GlobalSearch from '../components/GlobalSearch.vue'
import SearchHint from '../components/SearchHint.vue'
import ThemeToggle from '../components/ThemeToggle.vue'
import LanguageSwitcher from '../components/LanguageSwitcher.vue'
import MobileNav from '../components/MobileNav.vue'
import { coreLinks, secondaryEntries, navLinks, isActive, isNavGroup } from '../lib/nav'
import type { NavEntry } from '../lib/nav'

const pathname = Astro.url.pathname
const isActivePath = (path: string) => isActive(pathname, path)
---

<BaseLayout title={Astro.props.title} titleKey={Astro.props.titleKey} description={Astro.props.description} isErrorPage={Astro.props.isErrorPage}>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-brand-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-medium">Skip to content</a>
  <div class="min-h-screen flex flex-col bg-slate-50 dark:bg-dark-950 transition-colors">
    <header class="sticky top-0 z-40 border-b bg-white dark:bg-dark-900 border-slate-200/60 dark:border-dark-600/60">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center h-14 gap-5">
          <a href={asset("/")} class="flex items-center gap-3 group flex-shrink-0">
            <IsqLogo class="h-8 w-auto" />
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors hidden min-[1440px]:inline tracking-tight" data-i18n="text.international_system_of_quantities">International System of Quantities</span>
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors max-[1439px]:inline min-[1440px]:hidden tracking-tight">ISQ</span>
          </a>

          <nav class="hidden md:flex items-center gap-0.5" aria-label="Primary">
            {coreLinks.map((link) => (
              <a href={link.to} data-i18n={link.i18nKey} class={`px-2.5 py-1.5 whitespace-nowrap rounded-lg text-xs transition-colors ${isActivePath(link.to) ? 'bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 font-medium' : 'text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-50 dark:hover:bg-dark-700 font-medium'}`}>{link.label}</a>
            ))}
          </nav>

          <div class="ml-auto flex items-center gap-1">
            <button id="search-trigger-mobile" class="xl:hidden p-2 rounded-lg text-slate-400 dark:text-slate-500 hover:bg-slate-100 dark:hover:bg-dark-700 transition-colors" aria-label="Search" aria-haspopup="dialog">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </button>
            <button id="search-trigger" class="hidden xl:flex items-center gap-2.5 px-3.5 py-1.5 rounded-xl border border-slate-200 dark:border-dark-600 bg-slate-50/50 dark:bg-dark-800/50 text-slate-400 dark:text-slate-500 text-sm hover:border-slate-300 dark:hover:border-dark-500 hover:text-slate-500 dark:hover:text-slate-400 transition-all min-w-[200px]" aria-haspopup="dialog">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <span class="flex-1 text-left" data-i18n="action.search">Search entries…</span>
              <kbd class="text-xs bg-white dark:bg-dark-700 px-1.5 py-0.5 rounded-md text-slate-400 dark:text-slate-500 font-mono border border-slate-200 dark:border-dark-500">/</kbd>
            </button>

            <nav class="hidden lg:flex items-center gap-1" aria-label="Secondary">
              {secondaryEntries.map((entry: NavEntry) => (
                isNavGroup(entry) ? (
                  <div class="relative group">
                    <button
                      type="button"
                      data-i18n={entry.i18nKey}
                      aria-haspopup="true"
                      class={`flex items-center gap-1 px-2.5 py-1.5 whitespace-nowrap rounded-lg text-xs transition-colors font-medium ${entry.items.some(i => isActivePath(i.to)) ? 'text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50' : 'text-slate-400 dark:text-slate-500 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-50 dark:hover:bg-dark-700'} focus:text-brand-600 dark:focus:text-brand-400 focus:bg-slate-50 dark:focus:bg-dark-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/40`}
                    >
                      {entry.label}
                      <svg class="w-3 h-3 opacity-60 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div class="absolute right-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
                      {entry.sections ? (
                        <div class="flex rounded-xl border border-slate-200/60 dark:border-dark-600/60 bg-white dark:bg-dark-900 shadow-lg shadow-slate-900/5 dark:shadow-black/30 p-3">
                          {entry.sections.map((section) => (
                            <div class="min-w-[180px]">
                              <div class="px-3 pb-2 pt-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500 font-mono flex items-center gap-2" data-i18n={section.labelKey}>
                                <span class={`inline-block w-3 h-[3px] ${section.labelKey === 'nav_section.learn' ? 'bg-brand-500' : 'bg-iec-500'}`}></span>
                                {section.label}
                              </div>
                              {section.items.map((item) => (
                                <a
                                  href={item.to}
                                  data-i18n={item.i18nKey}
                                  class={`block px-3 py-2 whitespace-nowrap rounded-lg text-xs transition-colors ${isActivePath(item.to) ? 'bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 font-medium' : 'text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-50 dark:hover:bg-dark-700 font-medium'}`}
                                >
                                  {item.label}
                                </a>
                              ))}
                            </div>
                          ))}
                        </div>
                      ) : (
                        <div class="min-w-[180px] rounded-xl border border-slate-200/60 dark:border-dark-600/60 bg-white dark:bg-dark-900 shadow-lg shadow-slate-900/5 dark:shadow-black/30 p-1.5">
                          {entry.items.map((item) => (
                            <a
                              href={item.to}
                              data-i18n={item.i18nKey}
                              class={`block px-3 py-2 whitespace-nowrap rounded-lg text-xs transition-colors ${isActivePath(item.to) ? 'bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 font-medium' : 'text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-50 dark:hover:bg-dark-700 font-medium'}`}
                            >
                              {item.label}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ) : (
                  <a href={entry.to} data-i18n={entry.i18nKey} class={`px-2.5 py-1.5 whitespace-nowrap rounded-lg text-xs transition-colors ${isActivePath(entry.to) ? 'bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 font-medium' : 'text-slate-400 dark:text-slate-500 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-50 dark:hover:bg-dark-700 font-medium'}`}>{entry.label}</a>
                )
              ))}
            </nav>

            <LanguageSwitcher client:idle />

            <ThemeToggle client:only="vue" />

            <MobileNav client:only="vue" links={navLinks} activePath={pathname} />
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <SiteFooter />
    <BackToTop client:only="vue" />
    <AppToast client:only="vue" />
    <GlobalSearch client:only="vue" />
    <SearchHint client:only="vue" />
  </div>

  <script>
    document.getElementById('search-trigger')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search'))
    })
    document.getElementById('search-trigger-mobile')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search'))
    })
  </script>
</BaseLayout>
