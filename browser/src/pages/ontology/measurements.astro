---
import DefaultLayout from '../../layouts/DefaultLayout.astro'
import { asset } from '../../lib/asset'
import { ontologyEntities } from '../../data/generated/ontology'
import type { OntologyEntityData } from '../../data/ontologyViewModel'

const K = 'page.methodology.measurements_index.'

const all = ontologyEntities as readonly OntologyEntityData[]

const measurements = all
  .filter((e) => e.type === 'individual' && e.assertions?.some((a) => a.predicate === 'isq:measurementOf'))
  .map((e) => {
    const pick = (predicate: string) => e.literals?.find((l) => l.predicate === predicate)?.value
    const objectOf = (predicate: string) => e.assertions?.find((a) => a.predicate === predicate)?.objects ?? []
    return {
      entity: e,
      measured: objectOf('isq:measurementOf')[0],
      unit: objectOf('isq:hasUnit')[0],
      instantiated: objectOf('isq:instantiates')[0],
      value: pick('isq:hasValue'),
      uncertainty: pick('isq:uncertainty'),
      measuredAt: pick('isq:measuredAt'),
    }
  })
  .sort((a, b) => (a.measuredAt ?? '').localeCompare(b.measuredAt ?? ''))
---

<DefaultLayout title="Measurements | ISQ Browser" description="Measurement records modelled as ISQ MeasuredQuantity individuals — supplied through the ontology intake contract, not published by the ISQ Browser.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
      <a href={asset('/ontology')} class="hover:text-brand-600 transition-colors">Ontology</a>
      <span>/</span>
      <span>Measurements</span>
    </nav>

    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight heading-serif" data-i18n={K + 'title'}>Measurements</h1>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-3xl" data-i18n-html={K + 'intro_1'}>
      Measurement records are <strong class="text-slate-700 dark:text-slate-300">not published by the ISQ Browser</strong>.
      This page renders <code class="text-xs font-mono">isq:MeasuredQuantity</code> individuals supplied by an ontology
      intake file using the Pendrill measurement model. The bundled rod example is reference data for the model itself.
    </p>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-3xl" data-i18n-html={K + 'intro_2'}>
      To supply your own measurements, see the <a href={asset('/methodology/measurements')} class="text-brand-600 dark:text-brand-400 font-medium hover:underline">intake contract</a> —
      a single Turtle file using the <code class="text-xs font-mono">isq:</code> terms is all that is required.
    </p>

    <div class="mt-8 grid gap-3">
      {measurements.length === 0 && (
        <div class="p-8 rounded-xl border border-dashed border-slate-200 dark:border-dark-600 text-center text-sm text-slate-400" data-i18n={K + 'empty'}>
          No measurement records are loaded.
        </div>
      )}
      {measurements.map((m) => (
        <a href={asset(`/ontology/${m.entity.slug}`)} class="group block p-5 rounded-xl bg-white dark:bg-dark-800 border border-slate-200/60 dark:border-dark-600/60 hover:border-cyan-300 dark:hover:border-cyan-800 hover:shadow-sm transition-all">
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="text-lg font-bold font-mono text-slate-900 dark:text-slate-100">
              {m.value ?? '—'}{m.uncertainty ? ` ± ${m.uncertainty}` : ''}
            </span>
            {m.unit && <span class="text-sm font-mono text-slate-500 dark:text-slate-400">{m.unit}</span>}
            {m.measuredAt && <span class="text-xs text-slate-400">at {m.measuredAt}</span>}
          </div>
          <div class="mt-1.5 text-sm text-slate-600 dark:text-slate-400 group-hover:text-cyan-700 dark:group-hover:text-cyan-400 transition-colors">
            {m.entity.label}
          </div>
          <div class="mt-1 flex flex-wrap gap-3 text-xs text-slate-400 dark:text-slate-500">
            {m.measured && <span>measured quantity: <code class="font-mono">{m.measured}</code></span>}
            {m.instantiated && <span>entity instance: <code class="font-mono">{m.instantiated}</code></span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</DefaultLayout>
