---
import { asset } from '../lib/asset'

interface Props {
  active?: 'overview' | 'emblem' | 'history' | 'ecosystem'
}
const { active } = Astro.props

const items = [
  { slug: '', label: 'Overview', key: 'overview' as const, i18nKey: 'page.about.nav.overview' },
  { slug: '/emblem', label: 'Emblem', key: 'emblem' as const, i18nKey: 'page.about.nav.emblem' },
  { slug: '/history', label: 'History', key: 'history' as const, i18nKey: 'page.about.nav.history' },
  { slug: '/ecosystem', label: 'Ecosystem', key: 'ecosystem' as const, i18nKey: 'page.about.nav.ecosystem' },
]
---

<nav class="sticky top-14 z-30 bg-white/80 dark:bg-dark-900/80 backdrop-blur-md border-b border-slate-200/60 dark:border-dark-600/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-1 overflow-x-auto no-scrollbar h-11">
      {items.map((item) => (
        <a
          href={asset(`/about${item.slug}`)}
          data-i18n={item.i18nKey}
          class={`flex-shrink-0 px-4 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            active === item.key
              ? 'bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400'
              : 'text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-50 dark:hover:bg-dark-700'
          }`}
        >{item.label}</a>
      ))}
    </div>
  </div>
</nav>
