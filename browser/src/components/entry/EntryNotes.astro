---
import type { EntryDetailView } from '../../data/entryViewModel'

interface Props {
  view: EntryDetailView
}

const { view } = Astro.props
---

{(view.remHtml || view.remHtmlFr) && (
  <div class="mb-12">
    <h2 class="flex items-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-[0.15em] mb-4">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
      <span data-i18n="label.remarks">Notes</span>
    </h2>
    <div class="relative rounded-2xl bg-amber-50/60 dark:bg-amber-950/30 border border-amber-200/50 dark:border-amber-700/30 overflow-hidden">
      <div class="absolute left-0 inset-y-0 w-1.5 bg-gradient-to-b from-amber-400 to-amber-600 dark:from-amber-500 dark:to-amber-700" />
      <div class="p-6 sm:p-8 pl-7 sm:pl-9">
        {view.remHtml && (
          <>
            <div class="flex items-baseline gap-2 mb-2">
              <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase bg-brand-50 dark:bg-brand-950/40 px-1.5 py-0.5 rounded flex-shrink-0">EN</span>
            </div>
            <div class="text-slate-700 dark:text-slate-200 leading-relaxed text-base sm:text-base space-y-4" set:html={view.remHtml} />
          </>
        )}
        {view.remHtmlFr && (
          <div class={view.remHtml ? 'mt-4 pt-4 border-t border-amber-200/50 dark:border-amber-800/40' : ''}>
            <div class="flex items-baseline gap-2 mb-2">
              <span class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase bg-amber-100 dark:bg-amber-950/40 px-1.5 py-0.5 rounded flex-shrink-0">FR</span>
            </div>
            <div class="text-slate-700 dark:text-slate-200 leading-relaxed text-base sm:text-base space-y-4" set:html={view.remHtmlFr} />
          </div>
        )}
      </div>
    </div>
  </div>
)}
