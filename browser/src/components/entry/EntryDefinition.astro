---
import type { EntryDetailView } from '../../data/entryViewModel'

interface Props {
  view: EntryDetailView
}

const { view } = Astro.props
---

<div class="mb-12">
  <h2 class="flex items-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-[0.15em] mb-4">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.351.026.622.31.802.677L12 21l2.652-5.227c.18-.366.451-.65.802-.677a42.377 42.377 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/></svg>
    <span data-i18n="label.definition">Definition</span>
  </h2>
  <div class="relative rounded-2xl bg-white dark:bg-dark-800 border border-slate-200/60 dark:border-dark-600/60 overflow-hidden shadow-sm group/def">
    <div class="absolute left-0 inset-y-0 w-1.5 transition-all duration-300 group-hover/def:w-2" style={view.accent.defAccentStyle} />
    <div class="p-6 sm:p-8 pl-7 sm:pl-9">
      <div class="flex items-baseline gap-2 mb-2">
        <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase bg-brand-50 dark:bg-brand-950/40 px-1.5 py-0.5 rounded flex-shrink-0">EN</span>
      </div>
      <div class="text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-base space-y-4" set:html={view.defHtml} />
      {view.defHtmlFr && (
        <div class="mt-4 pt-4 border-t border-slate-200/60 dark:border-dark-700/60">
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase bg-amber-50 dark:bg-amber-950/40 px-1.5 py-0.5 rounded flex-shrink-0">FR</span>
          </div>
          <div class="text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-base space-y-4" set:html={view.defHtmlFr} />
        </div>
      )}
    </div>
  </div>
</div>
